rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can browse cars; only the admin account can change them.
    // Replace the email below with your VITE_ADMIN_EMAIL value (lowercase).
    // The account must be email-verified (run verify-admin.js once), so a
    // stranger can't become admin by registering the admin's email first.
    match /cars/{carId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "REPLACE_WITH_ADMIN_EMAIL"
                   && request.auth.token.email_verified == true;
    }

    // A signed-in user can read and write only their own wishlist.
    match /users/{uid}/wishlist/{carId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
