# Copy this file to `.env` and fill it in. `.env` is gitignored: never commit it.
# Every variable is read at build time by Vite (the VITE_ prefix exposes it to
# the browser bundle), so none of them may hold a real secret.

# Firebase web app config: Firebase console > Project settings > General >
# Your apps > SDK setup and configuration. These identify the project; they are
# not secrets (Firestore/Storage rules are what protect the data).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email of the single admin account (create it in Firebase console >
# Authentication > Users). Lowercase. It must match the email placed in
# firestore.rules and storage.rules; the app only uses it to decide what to
# show, the rules are the real gate.
VITE_ADMIN_EMAIL=

# Optional, local development only: set to "true" to talk to the Firebase
# emulators (see README) instead of the real project. Leave unset for
# production builds.
# VITE_USE_EMULATORS=true
